{
    "editor.rulers": [
        120
    ],
    "autoDocstring.docstringFormat": "numpy",
    "autoDocstring.startOnNewLine": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    // Use the project's pinned ruff (.venv) instead of the version bundled in the extension, so editor format-on-save
    // matches `uv run ruff format`. Without this the extension drifts on auto-update.
    "ruff.importStrategy": "fromEnvironment",
    "editor.formatOnSave": true,
    "[markdown]": {
        "editor.formatOnSave": false
    },
    "editor.codeActionsOnSave": {
        "source.organizeImports.ruff": "explicit"
    },
    "rewrap.autoWrap.enabled": true,
    "notebook.formatOnSave.enabled": true,
    "notebook.defaultFormatter": "charliermarsh.ruff",
    "python.defaultInterpreterPath": ".venv/bin/python",
    // NOTE: the pyrefly extension seems to globally add
    //
    // "python.languageServer": "None",
    // "cursorpyright.disableLanguageServices": true,
    //
    // to /Users/.../Library/Application Support/Cursor/User/settings.json
    // even when it's only enabled in one workspace.
    //
    // "python.pyrefly.typeCheckingMode": "default",
    // "python.pyrefly.diagnosticMode": "workspace",
}
